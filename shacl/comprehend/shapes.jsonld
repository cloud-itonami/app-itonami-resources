{
  "@context": {
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "sh": "http://www.w3.org/ns/shacl#",
    "prov": "http://www.w3.org/ns/prov#",
    "schema": "https://schema.org/",
    "itonami": "https://resources.itonami.cloud/ontology#"
  },
  "@graph": [
    {
      "@id": "itonami:ComprehendObservationShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": "itonami:Observation",
      "sh:property": [
        {
          "sh:path": "prov:generatedAtTime",
          "sh:datatype": "xsd:dateTime",
          "sh:minCount": 1
        }
      ]
    },
    {
      "@id": "itonami:DomainObservationShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": "itonami:DomainObservation",
      "sh:property": [
        {
          "sh:path": "itonami:domain",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1
        },
        {
          "sh:path": "itonami:source",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1
        }
      ]
    },
    {
      "@id": "itonami:IPObservationShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": "itonami:IPObservation",
      "sh:property": [
        {
          "sh:path": "itonami:ip",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1
        },
        {
          "sh:path": "itonami:source",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1
        }
      ]
    },
    {
      "@id": "itonami:CrawlRequestShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": "itonami:CrawlRequest",
      "sh:property": [
        {
          "sh:path": "schema:url",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1
        },
        {
          "sh:path": "itonami:maxDepth",
          "sh:datatype": "xsd:integer",
          "sh:minCount": 0
        }
      ]
    }
  ]
}
