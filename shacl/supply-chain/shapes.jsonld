{
  "@context": [
    "https://resources.itonami.cloud/ontology/supply-chain/context.jsonld",
    {
      "sh": "http://www.w3.org/ns/shacl#",
      "xsd": "http://www.w3.org/2001/XMLSchema#"
    }
  ],
  "@graph": [
    {
      "@id": "itonami:MaterialSourceShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": "itonami:MaterialSource",
      "sh:property": [
        {
          "sh:path": "schema:identifier",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:maxCount": 1
        },
        {
          "sh:path": "schema:name",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1
        },
        {
          "sh:path": "itonami:materialCategory",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:in": [
            "iron",
            "petroleum",
            "fiber",
            "food"
          ]
        },
        {
          "sh:path": "itonami:materialType",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1
        },
        {
          "sh:path": "schema:latitude",
          "sh:datatype": "xsd:decimal",
          "sh:minCount": 1
        },
        {
          "sh:path": "schema:longitude",
          "sh:datatype": "xsd:decimal",
          "sh:minCount": 1
        },
        {
          "sh:path": "itonami:countryCode",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:pattern": "^[A-Z]{2}$"
        },
        {
          "sh:path": "itonami:estimatedReserves",
          "sh:datatype": "xsd:decimal",
          "sh:minCount": 0
        },
        {
          "sh:path": "itonami:dailyOutput",
          "sh:datatype": "xsd:decimal",
          "sh:minCount": 0
        },
        {
          "sh:path": "itonami:unitOfMeasure",
          "sh:datatype": "xsd:string"
        },
        {
          "sh:path": "prov:generatedAtTime",
          "sh:datatype": "xsd:dateTime",
          "sh:minCount": 1
        }
      ]
    },
    {
      "@id": "itonami:SupplyCompanyShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": "itonami:SupplyCompany",
      "sh:property": [
        {
          "sh:path": "schema:identifier",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:maxCount": 1
        },
        {
          "sh:path": "schema:name",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1
        },
        {
          "sh:path": "itonami:countryCode",
          "sh:datatype": "xsd:string",
          "sh:pattern": "^[A-Z]{2}$"
        },
        {
          "sh:path": "itonami:isicSection",
          "sh:datatype": "xsd:string"
        },
        {
          "sh:path": "prov:generatedAtTime",
          "sh:datatype": "xsd:dateTime",
          "sh:minCount": 1
        }
      ]
    },
    {
      "@id": "itonami:SupplyPersonShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": "itonami:SupplyPerson",
      "sh:property": [
        {
          "sh:path": "schema:identifier",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:maxCount": 1
        },
        {
          "sh:path": "schema:name",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1
        },
        {
          "sh:path": "itonami:affiliatedCompanyIds",
          "sh:datatype": "xsd:string"
        },
        {
          "sh:path": "prov:generatedAtTime",
          "sh:datatype": "xsd:dateTime",
          "sh:minCount": 1
        }
      ]
    },
    {
      "@id": "itonami:SupplyFamilyShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": "itonami:SupplyFamily",
      "sh:property": [
        {
          "sh:path": "schema:identifier",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:maxCount": 1
        },
        {
          "sh:path": "schema:name",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1
        },
        {
          "sh:path": "itonami:countryCode",
          "sh:datatype": "xsd:string"
        },
        {
          "sh:path": "prov:generatedAtTime",
          "sh:datatype": "xsd:dateTime",
          "sh:minCount": 1
        }
      ]
    },
    {
      "@id": "itonami:ManufacturingPlantShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": "itonami:ManufacturingPlant",
      "sh:property": [
        {
          "sh:path": "schema:identifier",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:maxCount": 1
        },
        {
          "sh:path": "schema:name",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1
        },
        {
          "sh:path": "itonami:plantType",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:in": [
            "assembly",
            "processing",
            "fabrication"
          ]
        },
        {
          "sh:path": "itonami:isicDivision",
          "sh:datatype": "xsd:string"
        },
        {
          "sh:path": "schema:latitude",
          "sh:datatype": "xsd:decimal",
          "sh:minCount": 1
        },
        {
          "sh:path": "schema:longitude",
          "sh:datatype": "xsd:decimal",
          "sh:minCount": 1
        },
        {
          "sh:path": "itonami:inputMaterials",
          "sh:datatype": "xsd:string"
        },
        {
          "sh:path": "itonami:outputProducts",
          "sh:datatype": "xsd:string"
        },
        {
          "sh:path": "prov:generatedAtTime",
          "sh:datatype": "xsd:dateTime",
          "sh:minCount": 1
        }
      ]
    },
    {
      "@id": "itonami:ProcessingPlantShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": "itonami:ProcessingPlant",
      "sh:property": [
        {
          "sh:path": "schema:identifier",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:maxCount": 1
        },
        {
          "sh:path": "schema:name",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1
        },
        {
          "sh:path": "itonami:processType",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:in": [
            "smelting",
            "refining",
            "milling",
            "spinning"
          ]
        },
        {
          "sh:path": "schema:latitude",
          "sh:datatype": "xsd:decimal",
          "sh:minCount": 1
        },
        {
          "sh:path": "schema:longitude",
          "sh:datatype": "xsd:decimal",
          "sh:minCount": 1
        },
        {
          "sh:path": "itonami:inputMaterials",
          "sh:datatype": "xsd:string"
        },
        {
          "sh:path": "itonami:outputMaterials",
          "sh:datatype": "xsd:string"
        },
        {
          "sh:path": "prov:generatedAtTime",
          "sh:datatype": "xsd:dateTime",
          "sh:minCount": 1
        }
      ]
    },
    {
      "@id": "itonami:LogisticsHubShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": "itonami:LogisticsHub",
      "sh:property": [
        {
          "sh:path": "schema:identifier",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:maxCount": 1
        },
        {
          "sh:path": "schema:name",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1
        },
        {
          "sh:path": "itonami:hubType",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:in": [
            "warehouse",
            "port",
            "terminal",
            "distribution-center",
            "airport"
          ]
        },
        {
          "sh:path": "schema:latitude",
          "sh:datatype": "xsd:decimal",
          "sh:minCount": 1
        },
        {
          "sh:path": "schema:longitude",
          "sh:datatype": "xsd:decimal",
          "sh:minCount": 1
        },
        {
          "sh:path": "itonami:capacityTonnes",
          "sh:datatype": "xsd:decimal"
        },
        {
          "sh:path": "itonami:unLocode",
          "sh:datatype": "xsd:string",
          "sh:pattern": "^[A-Z]{2}[A-Z0-9]{3}$"
        },
        {
          "sh:path": "prov:generatedAtTime",
          "sh:datatype": "xsd:dateTime",
          "sh:minCount": 1
        }
      ]
    },
    {
      "@id": "itonami:LogisticsVehicleShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": "itonami:LogisticsVehicle",
      "sh:property": [
        {
          "sh:path": "schema:identifier",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:maxCount": 1
        },
        {
          "sh:path": "schema:name",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1
        },
        {
          "sh:path": "itonami:vehicleType",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:in": [
            "truck",
            "tanker",
            "flatbed",
            "van",
            "reefer"
          ]
        },
        {
          "sh:path": "itonami:registrationNumber",
          "sh:datatype": "xsd:string"
        },
        {
          "sh:path": "itonami:capacityTonnes",
          "sh:datatype": "xsd:decimal"
        },
        {
          "sh:path": "prov:generatedAtTime",
          "sh:datatype": "xsd:dateTime",
          "sh:minCount": 1
        }
      ]
    },
    {
      "@id": "itonami:LogisticsVesselShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": "itonami:LogisticsVessel",
      "sh:property": [
        {
          "sh:path": "schema:identifier",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:maxCount": 1
        },
        {
          "sh:path": "schema:name",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1
        },
        {
          "sh:path": "itonami:vesselType",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:in": [
            "container",
            "bulk",
            "tanker",
            "roro",
            "general"
          ]
        },
        {
          "sh:path": "itonami:imoNumber",
          "sh:datatype": "xsd:string",
          "sh:pattern": "^[0-9]{7}$"
        },
        {
          "sh:path": "itonami:deadweightTonnes",
          "sh:datatype": "xsd:decimal"
        },
        {
          "sh:path": "itonami:flagState",
          "sh:datatype": "xsd:string",
          "sh:pattern": "^[A-Z]{2}$"
        },
        {
          "sh:path": "prov:generatedAtTime",
          "sh:datatype": "xsd:dateTime",
          "sh:minCount": 1
        }
      ]
    },
    {
      "@id": "itonami:LogisticsRailwayShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": "itonami:LogisticsRailway",
      "sh:property": [
        {
          "sh:path": "schema:identifier",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:maxCount": 1
        },
        {
          "sh:path": "schema:name",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1
        },
        {
          "sh:path": "itonami:serviceType",
          "sh:datatype": "xsd:string",
          "sh:in": [
            "freight",
            "intermodal",
            "unit-train"
          ]
        },
        {
          "sh:path": "itonami:capacityTonnes",
          "sh:datatype": "xsd:decimal"
        },
        {
          "sh:path": "prov:generatedAtTime",
          "sh:datatype": "xsd:dateTime",
          "sh:minCount": 1
        }
      ]
    },
    {
      "@id": "itonami:LogisticsContainerShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": "itonami:LogisticsContainer",
      "sh:property": [
        {
          "sh:path": "schema:identifier",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:maxCount": 1
        },
        {
          "sh:path": "itonami:containerNumber",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:pattern": "^[A-Z]{4}[0-9]{7}$"
        },
        {
          "sh:path": "itonami:containerType",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:in": [
            "dry",
            "reefer",
            "tank",
            "open-top",
            "flat-rack"
          ]
        },
        {
          "sh:path": "itonami:sizeTeu",
          "sh:datatype": "xsd:decimal",
          "sh:minCount": 1,
          "sh:in": [
            1,
            2
          ]
        },
        {
          "sh:path": "itonami:maxPayloadKg",
          "sh:datatype": "xsd:decimal"
        },
        {
          "sh:path": "itonami:transportMode",
          "sh:datatype": "xsd:string",
          "sh:in": [
            "sea",
            "rail",
            "road",
            "yard"
          ]
        },
        {
          "sh:path": "prov:generatedAtTime",
          "sh:datatype": "xsd:dateTime",
          "sh:minCount": 1
        }
      ]
    }
  ]
}
